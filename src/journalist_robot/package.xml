<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>journalist_robot</name>
  <version>1.0.0</version>
  <description>
    Autonomous robotic journalism: a newsworthiness-driven mobile robot that decides where to look
    with a vision-language model, records mission-relevant footage, and turns it into article drafts.
  </description>
  <maintainer email="ranulfo@tohoku.ac.jp">Ranulfo Bezerra</maintainer>
  <license>Apache-2.0</license>
  <author>Ahmed Youssef</author>
  <author>Ranulfo Bezerra</author>
  <author>Tsige Tadesse Alemayoh</author>
  <author>Shotaro Kojima</author>
  <author>Kazunori Ohno</author>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>journalist_robot_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>  <!-- read by the launch file -->
  <!-- Optional, only for microphone input (audio_enabled: true): audio_common_msgs.
       It is not listed as a hard dependency so the system runs without audio. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
